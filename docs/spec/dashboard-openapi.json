{
  "openapi": "3.1.0",
  "info": {
    "title": "Unify Compute dashboard API",
    "version": "v1-draft",
    "description": "The /dashboard/v1 routes the dashboard pages call (ADR-0011, docs/spec/accounts.md). Served by compute-api only with ACCOUNTS_BACKEND=local and only on the app host (Host = APP_ORIGIN's host, else 404); with the console backend none of it exists. Not part of the job API contract (compute-api/internal/api/openapi.json): no API key is accepted here and no cookie there. Every non-GET needs Origin = APP_ORIGIN; session routes need the __Host-uc_session cookie and, for non-GET, X-CSRF-Token. compute-api/internal/dashboard tests hold this document's operations against the registered routes. Keys, balance, jobs and top-ups (A5, A7c, B1) are not here yet.",
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://app.staging.compute.unifyai.us",
      "description": "Staging. Not applied yet."
    },
    {
      "url": "https://app.compute.unifyai.us",
      "description": "Production. Not live; production runs the console backend."
    }
  ],
  "paths": {
    "/dashboard/v1/config": {
      "get": {
        "operationId": "getConfig",
        "summary": "What the signed-out pages need",
        "description": "turnstile_site_key is null while Turnstile is off (ADR-0011 D5).",
        "security": [],
        "responses": {
          "200": {
            "description": "Config.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "turnstile_site_key": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "min_password_length": {
                      "type": "integer"
                    },
                    "topup": {
                      "type": "object",
                      "properties": {
                        "min_usd": {
                          "type": "string"
                        },
                        "max_usd": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "turnstile_site_key",
                    "min_password_length",
                    "topup"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "not_found: Host is not the app host. The whole prefix is 404 on any other host.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/v1/signup": {
      "post": {
        "operationId": "signup",
        "summary": "Create an account and email a code",
        "description": "Always 202 for a well-formed request. A new address gets a 6-digit code; a registered one gets the 'someone tried to sign up' email instead, so the answer never says which. Throttled 5 per IP per hour, counted after validation.",
        "security": [],
        "responses": {
          "202": {
            "description": "Accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "verification_sent"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "malformed_body, bot_check_failed, invalid_email, password_mismatch, weak_password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "csrf_failed: Origin is not APP_ORIGIN (every non-GET), or X-CSRF-Token does not match the session (session routes).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: Host is not the app host. The whole prefix is 404 on any other host.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: a throttle refused the attempt. Always with Retry-After (seconds).",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "email_unavailable: SES refused the code; the signup was rolled back and the address is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "password_confirm": {
                    "type": "string"
                  },
                  "website": {
                    "type": "string",
                    "description": "Honeypot. Hidden from people; must be absent or empty, else 400 bot_check_failed (ADR-0011 D5: no Turnstile)."
                  }
                },
                "required": [
                  "email",
                  "password",
                  "password_confirm"
                ]
              }
            }
          }
        }
      }
    },
    "/dashboard/v1/verify": {
      "post": {
        "operationId": "verify",
        "summary": "Enter the code; activates and logs in",
        "description": "Any wrong, expired, exhausted (5 wrong) or superseded code, or an unknown address, is the same invalid_code. Wrong codes count 20 per IP per hour.",
        "security": [],
        "responses": {
          "200": {
            "description": "Logged in. The cookie is set; keep csrf_token for X-CSRF-Token.",
            "headers": {
              "Set-Cookie": {
                "description": "__Host-uc_session=<token>; Path=/; Max-Age=604800; HttpOnly; Secure; SameSite=Lax",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "malformed_body, invalid_code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "csrf_failed: Origin is not APP_ORIGIN (every non-GET), or X-CSRF-Token does not match the session (session routes).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: Host is not the app host. The whole prefix is 404 on any other host.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: a throttle refused the attempt. Always with Retry-After (seconds).",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "description": "6 digits; spaces are ignored."
                  }
                },
                "required": [
                  "email",
                  "code"
                ]
              }
            }
          }
        }
      }
    },
