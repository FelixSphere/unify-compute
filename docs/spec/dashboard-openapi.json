    "/dashboard/v1/password/reset": {
      "post": {
        "operationId": "resetPassword",
        "summary": "Set a new password from a reset link",
        "description": "Ends every session of the user (and clears this browser's cookie); does not log in. Verifies a pending address.",
        "security": [],
        "responses": {
          "200": {
            "description": "Password set.",
            "headers": {
              "Set-Cookie": {
                "description": "__Host-uc_session=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax (cleared)",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "password_reset"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "malformed_body, password_mismatch, invalid_token, weak_password.",
            "content": {
              "application/json": {
                "schema": {
