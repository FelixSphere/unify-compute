                  },
                  "password": {
                    "type": "string"
                  },
                  "password_confirm": {
                    "type": "string"
                  }
                },
                "required": [
                  "token",
                  "password",
                  "password_confirm"
                ]
              }
            }
          }
        }
      }
    },
