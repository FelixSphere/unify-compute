        "security": [],
        "responses": {
          "200": {
            "description": "Logged in. The cookie is set; keep csrf_token for X-CSRF-Token.",
            "headers": {
              "Set-Cookie": {
                "description": "__Host-uc_session=<token>; Path=/; Max-Age=604800; HttpOnly; Secure; SameSite=Lax",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
