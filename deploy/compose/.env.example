# Local development values for deploy/compose/docker-compose.yml.
#
#     cp deploy/compose/.env.example deploy/compose/.env
#
# .env is gitignored and ci.yml rejects it if it is ever tracked. This file is
# the template only: every secret here is a placeholder, and none of them may
# be used anywhere but a laptop.
#
# Hosted environments do NOT read this file. Each instance renders its own
# .env from SSM at boot (deploy/aws/modules/compute-stack/user-data.sh.tftpl);
# their pins live in deploy/aws/envs/<env>/variables.tf, not here.

# Local development runs the console too, like staging. Production's shape is
# docker-compose.yml alone.
COMPOSE_FILE=docker-compose.yml:docker-compose.console.yml
# docker-compose.skypilot.yml (the SkyPilot API server) is for hosts: it
# expects the files scripts/skypilot-host-setup.sh writes (./skypilot/ and
# $DATA_DIR/skypilot-aws/). To run a SkyPilot server locally for the backend
# tests, `sky api start` with an empty HOME is simpler (docs/spec/backend.md).

# --- Images -----------------------------------------------------------------
# Keep CONSOLE_IMAGE in step with the UnifyAPI production pin unless you are
# deliberately testing a console change. Defaults mirror
# deploy/aws/envs/staging/variables.tf; the site image is not published yet,
# so build it locally and set SITE_IMAGE to that tag.
CONSOLE_IMAGE=ghcr.io/felixsphere/unifyapi-console:unifyapi-v0.1.52@sha256:c22a1bfed2da54f33dc9b5dcb498fd18fd9949248284f2022e410e43df9ece87
COMPUTE_API_IMAGE=ghcr.io/felixsphere/unify-compute-api:dev
SITE_IMAGE=unify-compute-site:local

# --- Secrets ----------------------------------------------------------------
# Placeholders. Generate real local values with:
#
#     openssl rand -hex 32
#
# Use only characters that do not change the meaning of a connection URL
# ([0-9A-Za-z._~-]); POSTGRES_PASSWORD is interpolated into a postgresql:// DSN
# and REDIS_PASSWORD into a redis:// one, so a `/` or `@` here breaks the DSN
# rather than failing loudly. scripts/staging-secrets.sh enforces the same rule
# for staging.
POSTGRES_PASSWORD=change-me-local-only
REDIS_PASSWORD=change-me-local-only
SESSION_SECRET=change-me-local-only

# Dark until the console fork ships the bridge routes
# (docs/spec/console-billing-bridge.md). When it does, both sides need the same
# value — and never the production one. Empty means the bridge is off.
COMPUTE_BRIDGE_SECRET=

# --- Binding and environment ------------------------------------------------
# Loopback locally. Hosted environments set these to 0.0.0.0 because the ALB
# has to reach the containers; that is the stack's decision, not a default here.
CONSOLE_BIND=127.0.0.1
COMPUTE_API_BIND=127.0.0.1
SITE_BIND=127.0.0.1
CONSOLE_URL=http://console:3000

ENVIRONMENT=local
DATA_DIR=./data

# Secure cookies need the exact HTTPS origin. Locally the console runs over
# plain HTTP, so both stay off and the console's OriginGuard is disabled.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
