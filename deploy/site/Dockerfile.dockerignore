# BuildKit reads this instead of a root .dockerignore when building with
# -f deploy/site/Dockerfile, so the compute-api build is unaffected.
# Allowlist: only what `npm run build` reads, plus the Caddyfile.
*
!package.json
!package-lock.json
!next.config.ts
!vite.config.ts
!tsconfig.json
!components.json
!app/
!components/
!hooks/
!lib/
!public/
!dashboard/
# Writes sitemap.xml and robots.txt after the export (package.json "build").
!scripts/site-sitemap.mjs
# The marketplace pages are generated from the catalogue compute-api serves (ADR-0012).
!compute-api/config/skus.json
!compute-api/config/templates.json
!deploy/site/Caddyfile
